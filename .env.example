# Secure E2EE Messenger - example configuration.
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Every variable below is read by config.py.

# Flask session signing key. REQUIRED - the app refuses to start without it.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-hex-string

# SQLAlchemy database URL. A relative sqlite path is stored under instance/.
DATABASE_URL=sqlite:///chat.db

# mkcert certificate and key paths (Step 3). Never commit these files.
SSL_CERT=certs/localhost.pem
SSL_KEY=certs/localhost-key.pem

# Undelivered messages older than this many days are deleted by cleanup.py.
MESSAGE_TTL_DAYS=7

# Maximum size in bytes of a text message envelope.
MAX_TEXT_BYTES=16384

# Maximum size in bytes of the decoded PNG inside a stego envelope (3 MiB).
MAX_STEGO_BYTES=3145728

# Maximum number of queued messages from one sender to one recipient.
MAX_PENDING_PER_PAIR=100

# Session lifetime in minutes (set as the Flask session cookie max age).
SESSION_MINUTES=30

# Set to 1 to enable the /stego-lab page (Step 9). Keep 0 in normal use.
STEGO_LAB=0
